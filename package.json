{
  "name": "@mgd34msu/vibecheck-linear-jev",
  "version": "0.1.0",
  "description": "A coding-agent work ledger backed by Linear whose reports are checked by a Jev-compatible judgment model.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "vibecheck-linear-jev": "runtime/vibecheck-linear-jev.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "runtime",
    "README.md",
    "LICENSE",
    "docs/protocol.md",
    "docs/agent-usage.md",
    "docs/open-models.md",
    "examples/mcp.json",
    "skills"
  ],
  "author": {
    "name": "Mike Davis",
    "email": "mgd34msu@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgd34msu/vibecheck-linear-jev.git"
  },
  "homepage": "https://github.com/mgd34msu/vibecheck-linear-jev",
  "bugs": {
    "url": "https://github.com/mgd34msu/vibecheck-linear-jev/issues"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "bun scripts/check-types.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check:platforms": "bun scripts/check-platforms.ts",
    "build:release": "bun scripts/build-release.ts",
    "verify:release": "bun scripts/verify-release.ts",
    "test:bun": "bun test tests",
    "verify": "bun run format:check && bun run typecheck && bun run check:types && bun run check:bundle && bun run check:platforms && bun run test:bun && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-compiler-api": "npm:typescript@6.0.3"
  }
}
